{
  "expo": {
    "name": "متابعة الطلاب والحفظ",
    "slug": "mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "mobile",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/images/icon.png",
      "imageWidth": 150,
      "resizeMode": "contain",
      "backgroundColor": "#f7f5ed"
    },
    "ios": {
      "supportsTablet": false,
      "infoPlist": {
        "CFBundleDevelopmentRegion": "ar",
        "CFBundleLocalizations": ["ar"]
      }
    },
    "android": {
      "supportsRTL": true
    },
    "web": {
      "favicon": "./assets/images/icon.png",
      "output": "static"
    },
    "plugins": [
      "expo-router",
      "expo-sharing"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
